{
  "name": "synapse-discovery",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check.mjs --production && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run check && npm test && npm run test:runtime && npm run test:runtime:supabase",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "configure": "node scripts/setup.mjs",
    "test:runtime": "node tests/runtime.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:runtime:supabase": "node tests/runtime-supabase.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261023.1-beta",
    "playwright-core": "1.64.1",
    "wrangler": "4.154.0"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
